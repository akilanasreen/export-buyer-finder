# Copy to .env and fill in. Keys stay on the server and are never sent to the browser.
PORT=3000

# UN Comtrade (free "Comtrade API" subscription key): https://comtradedeveloper.un.org
COMTRADE_API_KEY=

# Google Maps Platform key with "Places API (New)" enabled and billing on:
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# OPTIONAL: Anthropic key used only to suggest product synonyms / local-language terms.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Maps Platform terms restrict exporting/storing Places content (names, addresses,
# phones). Default false = downloads only contain fields taken from business websites.
# Set true ONLY if your Google licence/legal review allows it.
EXPORT_MAPS_FIELDS=false
